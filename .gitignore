# ── Flutter / Dart ────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/

# Code generation artifacts
# Drift-generated files in shared_services are committed (required to build without running build_runner)
*.g.dart
!my_apps/packages/shared_services/**/*.g.dart
*.freezed.dart
*.mocks.dart
*.gr.dart

# pubspec.lock:
#   COMMIT for apps (apps/sfinance/, apps/dashboard/, etc.)
#   IGNORE for packages (packages/shared_*/):
packages/*/pubspec.lock

# ── Melos ─────────────────────────────────────────────────────────
.melos_tool/
melos_managed_symlinks/

# ── IDE ───────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.code-workspace

# ── OS ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Project scratch files ─────────────────────────────────────────
constitution_prompt.txt
specify_prompt.txt
plan_prompt.txt
*_prompt.txt

# ── Spec-kit local config ─────────────────────────────────────────
# init-options.json is a local setup artifact, not part of project source
.specify/init-options.json
